import merge from 'lodash.merge';
import path from 'path';
import { fileURLToPath, pathToFileURL } from 'url';
import { globSync } from 'glob';

// Resolved from this module, not from process.cwd(), so the server can be
// started from any working directory (Docker, PM2, a monorepo root...).
const resolversDir = path.dirname(fileURLToPath(import.meta.url));

// Collect every *Resolver.js file
const resolverFiles = globSync('**/*Resolver.js', { cwd: resolversDir });

// Import each resolver dynamically
const resolversArray = [];

for (const file of resolverFiles) {
  const modulePath = pathToFileURL(path.join(resolversDir, file)).href;
  const mod = await import(modulePath);
  if (mod.default) resolversArray.push(mod.default);
}

export default merge({}, ...resolversArray, {
  Query: {
    _ping: () => 'pong',
  },
  Mutation: {
    _noop: () => true,
  },
});
