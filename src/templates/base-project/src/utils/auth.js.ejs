import jwt from 'jsonwebtoken';
import bcrypt from 'bcryptjs';

/**
 * JWT Authentication Utilities
 * Provides secure token generation and verification
 */

// Placeholder values shipped by the scaffolder. They are public knowledge, so a
// token signed with one can be forged by anyone: they are only ever tolerated
// outside production, and never silently.
const PLACEHOLDER_SECRETS = [
  'your-access-secret-change-in-production',
  'your-refresh-secret-change-in-production',
  'change-me',
];

const MIN_SECRET_LENGTH = 32;

/**
 * Reads a JWT secret from the environment and refuses to start with a weak one.
 * @param {string} name - Environment variable name
 * @returns {string} The secret
 * @throws {Error} In production, if the secret is missing, a placeholder, or too short
 */
function requireSecret(name) {
  const value = process.env[name];
  const isProduction = process.env.NODE_ENV === 'production';

  let problem = null;
  if (!value) {
    problem = `${name} is not set`;
  } else if (PLACEHOLDER_SECRETS.includes(value)) {
    problem = `${name} still uses the scaffolded placeholder value`;
  } else if (value.length < MIN_SECRET_LENGTH) {
    problem = `${name} is shorter than ${MIN_SECRET_LENGTH} characters`;
  }

  if (!problem) {
    return value;
  }

  if (isProduction) {
    throw new Error(
      `[security] ${problem}. Refusing to start: JWT tokens would be forgeable. ` +
        'Generate one with: npm run security:generate-secret'
    );
  }

  console.warn(
    `⚠️  [security] ${problem}. Using an insecure development fallback — ` +
      'the server will refuse to start in production.'
  );
  return value || `insecure-development-${name.toLowerCase()}`;
}

const ACCESS_TOKEN_SECRET = requireSecret('ACCESS_TOKEN_SECRET');
const REFRESH_TOKEN_SECRET = requireSecret('REFRESH_TOKEN_SECRET');
const ACCESS_TOKEN_EXPIRY = process.env.ACCESS_TOKEN_EXPIRY || '15m';
const REFRESH_TOKEN_EXPIRY = process.env.REFRESH_TOKEN_EXPIRY || '7d';

if (ACCESS_TOKEN_SECRET === REFRESH_TOKEN_SECRET) {
  throw new Error(
    '[security] ACCESS_TOKEN_SECRET and REFRESH_TOKEN_SECRET must differ, ' +
      'otherwise a refresh token is accepted as an access token.'
  );
}

/**
 * Generates an access token for a user
 * @param {Object} payload - User data to encode (id, email, role)
 * @returns {string} JWT access token
 */
export function generateAccessToken(payload) {
  return jwt.sign(payload, ACCESS_TOKEN_SECRET, {
    expiresIn: ACCESS_TOKEN_EXPIRY,
    issuer: '<%= projectName %>',
    audience: '<%= projectName %>-api',
  });
}

/**
 * Generates a refresh token for a user
 * @param {Object} payload - User data to encode (id, email)
 * @returns {string} JWT refresh token
 */
export function generateRefreshToken(payload) {
  return jwt.sign(payload, REFRESH_TOKEN_SECRET, {
    expiresIn: REFRESH_TOKEN_EXPIRY,
    issuer: '<%= projectName %>',
    audience: '<%= projectName %>-api',
  });
}

/**
 * Generates both access and refresh tokens
 * @param {Object} user - User object with id, email, role
 * @returns {Object} { accessToken, refreshToken }
 */
export function generateTokenPair(user) {
  const payload = {
    id: user._id || user.id,
    email: user.email,
    role: user.role || 'user',
  };

  return {
    accessToken: generateAccessToken(payload),
    refreshToken: generateRefreshToken(payload),
  };
}

/**
 * Verifies an access token
 * @param {string} token - JWT token to verify
 * @returns {Object} Decoded token payload
 * @throws {Error} If token is invalid or expired
 */
export function verifyAccessToken(token) {
  try {
    return jwt.verify(token, ACCESS_TOKEN_SECRET, {
      issuer: '<%= projectName %>',
      audience: '<%= projectName %>-api',
    });
  } catch (error) {
    if (error.name === 'TokenExpiredError') {
      throw new Error('Access token expired');
    }
    if (error.name === 'JsonWebTokenError') {
      throw new Error('Invalid access token');
    }
    throw error;
  }
}

/**
 * Verifies a refresh token
 * @param {string} token - JWT refresh token to verify
 * @returns {Object} Decoded token payload
 * @throws {Error} If token is invalid or expired
 */
export function verifyRefreshToken(token) {
  try {
    return jwt.verify(token, REFRESH_TOKEN_SECRET, {
      issuer: '<%= projectName %>',
      audience: '<%= projectName %>-api',
    });
  } catch (error) {
    if (error.name === 'TokenExpiredError') {
      throw new Error('Refresh token expired');
    }
    if (error.name === 'JsonWebTokenError') {
      throw new Error('Invalid refresh token');
    }
    throw error;
  }
}

/**
 * Hashes a password using bcrypt
 * @param {string} password - Plain text password
 * @returns {Promise<string>} Hashed password
 */
export async function hashPassword(password) {
  const saltRounds = 12;
  return bcrypt.hash(password, saltRounds);
}

/**
 * Compares a plain text password with a hashed password
 * @param {string} password - Plain text password
 * @param {string} hash - Hashed password
 * @returns {Promise<boolean>} True if password matches
 */
export async function comparePassword(password, hash) {
  return bcrypt.compare(password, hash);
}

/**
 * Extracts token from Authorization header
 * @param {string} authHeader - Authorization header value
 * @returns {string|null} Token or null
 */
export function extractToken(authHeader) {
  if (!authHeader) return null;

  const parts = authHeader.split(' ');
  if (parts.length !== 2 || parts[0] !== 'Bearer') {
    return null;
  }

  return parts[1];
}

/**
 * Creates a sanitized user object (removes sensitive data)
 * @param {Object} user - User document from database
 * @returns {Object} Sanitized user object
 */
export function sanitizeUser(user) {
  const sanitized = { ...user };
  delete sanitized.password;
  delete sanitized.__v;
  return sanitized;
}
